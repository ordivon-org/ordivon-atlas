  "closure": "NOT_CLAIMED",
  "findings": [
    {
      "claim": "The external systems classify different things: policy priorities, R&D statistics, education fields and library holdings. Their disagreement is expected and informative.",
      "findingId": "FCR1-1",
      "standing": "ESTABLISHED_IN_SCOPE"
    },
    {
      "claim": "Several spaces recur strongly across views: mathematics, physics, chemistry, biology, engineering/technology, earth/geoscience, medicine/health and agriculture; recurrence does not by itself determine foundational root status.",
      "findingId": "FCR1-2",
      "standing": "SUPPORTED_IN_SCOPE"
    },
    {
      "claim": "Formal/computational spaces are fragmented by institutional views: mathematics/statistics, computer-information sciences, logic, information and systems appear at different levels, supporting a multi-node formal/abstract family rather than one Computer Science bucket.",
      "findingId": "FCR1-3",
      "standing": "SUPPORTED_IN_SCOPE"
    },
    {
      "claim": "Earth/ocean/atmosphere is too large to remain an incidental child of generic physics or geography; source views repeatedly expose geology/geophysics/meteorology/physical geography or separate geography classes.",
      "findingId": "FCR1-4",
      "standing": "SUPPORTED_IN_SCOPE"
    },
    {
      "claim": "Mind/language domains are classification-pressure zones: psychology, linguistics, cognitive science and neuroscience cut across natural, medical, social, humanities and library views.",
      "findingId": "FCR1-5",
      "standing": "SUPPORTED_IN_SCOPE"
    },
    {
      "claim": "Methodological foundations such as measurement/metrology can be central to knowledge production while being underrepresented as academic root disciplines; the Atlas census therefore needs a methodological-axis view in addition to discipline views.",
      "findingId": "FCR1-6",
      "standing": "PROVISIONAL_SUPPORTED"
    }
  ],
  "kind": "ordivon.foundational-knowledge-space-census-round1",
  "method": {
    "forbidden": [
      "Majority vote creates ontology truth",
      "Absence means nonexistent",
      "Institutional category equals foundational root",
      "A broad parent mapping proves subclass semantics"
    ],
    "principle": "Compare heterogeneous classification views without majority-vote ontology.",
    "signalSemantics": {
      "ABSENT_SCOPE": "Not named by this source view or outside its intended scope; never evidence of nonexistence.",
      "BROAD": "Representable under a broader source field/class; source does not settle root status.",
      "DIVERGENT": "Placement cuts across materially different source fields/classes.",
      "NAMED": "Explicitly named by the source view at a relevant level.",
      "SEPARATE": "Represented as a distinct major/top-level class or field in the source view."
    }
  },
  "next": "Round 2 should normalize identities and test candidate roles by family before admitting new canonical reference roots.",
